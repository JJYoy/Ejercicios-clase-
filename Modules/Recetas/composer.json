"extra": {
        "laravel": {
            "dont-discover": []
        },
    "merge-plugin": {
        "include": [
            "Modules/*/composer.json"
        ]
    }
},

    "autoload": {
        "psr-4": {
            "Modules\\Recetas\\": "app/",
            "Modules\\Recetas\\Database\\Factories\\": "database/factories/",
            "Modules\\Recetas\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Recetas\\Tests\\": "tests/"
        }
    }
}
